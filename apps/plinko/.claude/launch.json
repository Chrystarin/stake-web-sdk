{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "plinko-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3003
    },
    {
      "name": "plinko-dev-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "3103"],
      "port": 3103
    },
    {
      "name": "crazy-time",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "crazy-time", "exec", "vite", "dev", "--port", "3021", "--strictPort"],
      "port": 3021,
      "autoPort": false
    }
  ]
}
